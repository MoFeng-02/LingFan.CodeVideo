{
  "name": "lingfan-codevideo",
  "private": true,
  "type": "module",
  "description": "Code Video：确定性渲染引擎（游戏即视频）。包化代码在 packages/，示例与测试集中根目录。",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck && tsc -p tsconfig.json",
    "lint": "pnpm typecheck && pnpm format:check && pnpm lint:rules",
    "lint:rules": "eslint .",
    "test:unit": "vitest run",
    "build": "pnpm -r build",
    "format": "prettier --write \"packages/**/src/**/*.ts\" \"tests/**/*.ts\" \"examples/**/*.ts\"",
    "format:check": "prettier --check \"packages/**/src/**/*.ts\" \"tests/**/*.ts\" \"examples/**/*.ts\"",
    "dev": "vite examples/browser --open"
  },
  "devDependencies": {
    "@lingfan-video/contracts": "workspace:*",
    "@lingfan-video/core": "workspace:*",
    "@lingfan-video/infra": "workspace:*",
    "@types/node": "^22.7.0",
    "@types/three": "^0.186.0",
    "eslint": "^9.39.4",
    "prettier": "^3.3.3",
    "three": "^0.186.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.71.2",
    "vite": "^5.4.21",
    "vitest": "^2.1.1"
  }
}
